# ============================================================
# Backend (bug-tracker/backend)
# ============================================================

# PostgreSQL connection string.
# Local dev default matches docker-compose.yml.
# In production, use your managed Postgres connection string
# (e.g. from Neon, Supabase, or Railway).
DATABASE_URL=postgresql://bugmind:bugmind_dev_password@localhost:5432/bugmind

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your deployed frontend URL,
# e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Ollama server URL used for AI bug analysis and duplicate detection.
# Local dev default assumes Ollama running on your machine.
# In production, point this at a hosted/self-hosted Ollama instance.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ============================================================
# Frontend (bug-tracker/frontend)
# ============================================================

# URL of the deployed backend API.
# Local dev default assumes FastAPI running on your machine.
# In production, set this to your deployed backend URL,
# e.g. https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
